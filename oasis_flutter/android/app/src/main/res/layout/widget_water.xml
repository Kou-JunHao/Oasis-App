<?xml version="1.0" encoding="utf-8"?>
<!--
  HyperOS 适配：根布局必须使用 @android:id/background，系统才会替我们裁圆角。
  不使用 android:configure，直接在桌面上添加后点击卡片选择设备。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/btn_start_gradient"
            android:contentDescription="@string/widget_title"
            android:padding="3dp"
            android:src="@drawable/ic_water_drop" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/widget_title"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_start_gradient"
        android:stateListAnimator="@null"
        android:text="@string/widget_action_configure"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/widget_status_unconfigured"
        android:textColor="@color/widget_status_text"
        android:textSize="13sp" />
</LinearLayout>
